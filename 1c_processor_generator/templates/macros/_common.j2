{#- ============================================ #}
{#- FONT RENDERING                              #}
{#- ============================================ #}

{#- Render Font element (for LabelDecoration, InputField, etc.) #}
{#- v2.43.0: Fixed to use self-closing tag with attributes (not nested elements) #}
{#- v2.43.0+: Added tag parameter for TitleFont, faceName and scale attributes #}
{#- v2.68.0+: Added size as alias for height, face_name as alias for faceName #}
{#-           Auto-switch to sys:DefaultGUIFont/WindowsFont when size specified #}
{#- Format: <Font ref="style:NormalTextFont" bold="true" kind="StyleItem"/> #}
{#- With size: <Font ref="sys:DefaultGUIFont" height="20" bold="true" kind="WindowsFont"/> #}
{% macro render_font(font, indent='', tag='Font') -%}
{%- if font %}
{%- set font_height = font.get('height') or font.get('size') %}
{%- set font_face = font.get('faceName') or font.get('face_name') %}
{%- set use_system_font = font_height is not none %}
{%- set default_ref = 'sys:DefaultGUIFont' if use_system_font else 'style:NormalTextFont' %}
{%- set default_kind = 'WindowsFont' if use_system_font else 'StyleItem' %}
{{ indent }}<{{ tag }} ref="{{ font.get('ref', default_ref) }}"
{%- if font_face %} faceName="{{ font_face }}"{% endif %}
{%- if font_height %} height="{{ font_height }}"{% endif %}
{%- if font.get('bold') is not none %} bold="{{ font['bold']|lower }}"{% endif %}
{%- if font.get('italic') is not none %} italic="{{ font['italic']|lower }}"{% endif %}
{%- if font.get('underline') is not none %} underline="{{ font['underline']|lower }}"{% endif %}
{%- if font.get('strikethrough') is not none %} strikeout="{{ font['strikethrough']|lower }}"{% endif %}
{%- if font.get('scale') %} scale="{{ font['scale'] }}"{% endif %} kind="{{ font.get('kind', default_kind) }}"/>
{%- endif %}
{%- endmacro %}

{#- ============================================ #}
{#- COLOR RENDERING (v2.43.0+)                  #}
{#- ============================================ #}

{#- Render color property (HEX format: #RRGGBB) #}
{% macro render_color(value, indent='', tag='TextColor') -%}
{%- if value %}
{{ indent }}<{{ tag }}>{{ value }}</{{ tag }}>
{%- endif %}
{%- endmacro %}

{#- ============================================ #}
{#- CHOICE BUTTON PICTURE (v2.43.0+)            #}
{#- ============================================ #}

{#- Render ChoiceButtonPicture for InputField #}
{% macro render_choice_button_picture(picture, indent='', choice_button_explicit=none) -%}
{%- if picture %}
{%- if choice_button_explicit is none %}
{{ indent }}<ChoiceButton>true</ChoiceButton>
{%- endif %}
{{ indent }}<ChoiceButtonPicture>
{{ indent }}	<xr:Ref>{{ picture }}</xr:Ref>
{{ indent }}	<xr:LoadTransparent>true</xr:LoadTransparent>
{{ indent }}</ChoiceButtonPicture>
{%- endif %}
{%- endmacro %}

{#- ============================================ #}
{#- PICTURE RENDERING                           #}
{#- ============================================ #}

{#- Render Picture element (local or reference) #}
{% macro render_picture(props, indent='', transparent='false') -%}
{%- if props.get('local_picture') %}
{{ indent }}<Picture>
{{ indent }}	<xr:Abs>Picture.png</xr:Abs>
{{ indent }}	<xr:LoadTransparent>{{ transparent }}</xr:LoadTransparent>
{{ indent }}</Picture>
{%- elif props.get('picture') %}
{{ indent }}<Picture>
{{ indent }}	<xr:Ref>{{ props['picture'] }}</xr:Ref>
{{ indent }}	<xr:LoadTransparent>{{ transparent }}</xr:LoadTransparent>
{{ indent }}</Picture>
{%- endif %}
{%- endmacro %}

{#- ============================================ #}
{#- DATA PATH RENDERING                         #}
{#- ============================================ #}

{#- Render DataPath for element (handles custom path, form attribute, and object attribute) #}
{% macro render_data_path(elem, indent='') -%}
{%- if elem.properties.get('data_path') %}
{{ indent }}<DataPath>{{ elem.properties['data_path'] }}</DataPath>
{%- elif elem.get('is_form_attribute') %}
{{ indent }}<DataPath>{{ elem.attribute }}</DataPath>
{%- elif elem.attribute %}
{{ indent }}<DataPath>Объект.{{ elem.attribute }}</DataPath>
{%- endif %}
{%- endmacro %}

{#- Render DataPath for Table element (handles ValueTable vs TabularSection) #}
{% macro render_table_data_path(elem, indent='') -%}
{%- if elem.is_value_table %}
{{ indent }}<DataPath>{{ elem.tabular_section }}</DataPath>
{%- else %}
{{ indent }}<DataPath>Объект.{{ elem.tabular_section }}</DataPath>
{%- endif %}
{%- endmacro %}

{#- Render DataPath for table column (handles custom path, ValueTable, TabularSection) #}
{% macro render_column_data_path(elem, col, indent='') -%}
{%- if col.get('data_path') %}
{{ indent }}<DataPath>{{ col.data_path }}</DataPath>
{%- elif elem.is_value_table %}
{{ indent }}<DataPath>{{ elem.tabular_section }}.{{ col.name }}</DataPath>
{%- else %}
{{ indent }}<DataPath>Объект.{{ elem.tabular_section }}.{{ col.name }}</DataPath>
{%- endif %}
{%- endmacro %}

{#- Render DataPath for LineNumber column #}
{% macro render_line_number_data_path(elem, indent='') -%}
{%- if elem.is_value_table %}
{{ indent }}<DataPath>{{ elem.tabular_section }}.LineNumber</DataPath>
{%- else %}
{{ indent }}<DataPath>Объект.{{ elem.tabular_section }}.LineNumber</DataPath>
{%- endif %}
{%- endmacro %}

