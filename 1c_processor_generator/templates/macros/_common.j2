{#- ============================================ #}
{#- CONDITIONAL APPEARANCE (v2.67.0+)           #}
{#- ============================================ #}

{#- Render ConditionalAppearance block for element or form #}
{#- ca_items: List[ConditionalAppearanceItem] #}
{#- data_prefix: Prefix for data path (e.g., "Cells." for Table, "Объект." for form) #}
{% macro render_conditional_appearance(ca_items, data_prefix='', indent='') -%}
{%- if ca_items %}
{{ indent }}<ConditionalAppearance>
{%- for item in ca_items %}
{{ indent }}	<dcsset:item>
{{ indent }}		<dcsset:selection>
{%- for sel in item.selection %}
{{ indent }}			<dcsset:item>
{{ indent }}				<dcsset:field>{{ sel }}</dcsset:field>
{{ indent }}			</dcsset:item>
{%- endfor %}
{{ indent }}		</dcsset:selection>
{%- if item.filter %}
{{ indent }}		<dcsset:filter>
{{ indent }}			<dcsset:item xsi:type="dcsset:FilterItemComparison">
{{ indent }}				<dcsset:left xsi:type="dcscor:Field">{{ data_prefix }}{{ item.filter.field }}</dcsset:left>
{{ indent }}				<dcsset:comparisonType>{{ item.filter.comparison }}</dcsset:comparisonType>
{%- if item.filter.value_type == 'boolean' %}
{{ indent }}				<dcsset:right xsi:type="xs:boolean">{{ item.filter.value|string|lower }}</dcsset:right>
{%- elif item.filter.value_type == 'number' %}
{{ indent }}				<dcsset:right xsi:type="xs:decimal">{{ item.filter.value }}</dcsset:right>
{%- else %}
{{ indent }}				<dcsset:right xsi:type="xs:string">{{ item.filter.value|x }}</dcsset:right>
{%- endif %}
{{ indent }}			</dcsset:item>
{{ indent }}		</dcsset:filter>
{%- endif %}
{%- if item.appearance %}
{{ indent }}		<dcsset:appearance>
{%- if item.appearance.back_color %}
{{ indent }}			<dcscor:item xsi:type="dcsset:SettingsParameterValue">
{{ indent }}				<dcscor:parameter>ЦветФона</dcscor:parameter>
{{ indent }}				<dcscor:value xsi:type="v8ui:Color">{{ item.appearance.back_color }}</dcscor:value>
{{ indent }}			</dcscor:item>
{%- endif %}
{%- if item.appearance.text_color %}
{{ indent }}			<dcscor:item xsi:type="dcsset:SettingsParameterValue">
{{ indent }}				<dcscor:parameter>ЦветТекста</dcscor:parameter>
{{ indent }}				<dcscor:value xsi:type="v8ui:Color">{{ item.appearance.text_color }}</dcscor:value>
{{ indent }}			</dcscor:item>
{%- endif %}
{%- if item.appearance.visible is not none %}
{{ indent }}			<dcscor:item xsi:type="dcsset:SettingsParameterValue">
{{ indent }}				<dcscor:parameter>Видимость</dcscor:parameter>
{{ indent }}				<dcscor:value xsi:type="xs:boolean">{{ item.appearance.visible|string|lower }}</dcscor:value>
{{ indent }}			</dcscor:item>
{%- endif %}
{%- if item.appearance.enabled is not none %}
{{ indent }}			<dcscor:item xsi:type="dcsset:SettingsParameterValue">
{{ indent }}				<dcscor:parameter>Доступность</dcscor:parameter>
{{ indent }}				<dcscor:value xsi:type="xs:boolean">{{ item.appearance.enabled|string|lower }}</dcscor:value>
{{ indent }}			</dcscor:item>
{%- endif %}
{{ indent }}		</dcsset:appearance>
{%- endif %}
{{ indent }}	</dcsset:item>
{%- endfor %}
{{ indent }}</ConditionalAppearance>
{%- endif %}
{%- endmacro %}
