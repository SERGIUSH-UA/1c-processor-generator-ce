# Auto detect text files and perform LF normalization
* text=auto

# Python scripts should have LF line endings and be executable on Unix
*.py text eol=lf

# Shell scripts should have LF line endings and be executable on Unix
*.sh text eol=lf

# Batch scripts should have CRLF line endings
*.bat text eol=crlf

# YAML/JSON files should have LF line endings
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf

# Markdown documentation should have LF line endings
*.md text eol=lf

# BSL files (1C code) should have CRLF line endings (1C standard)
*.bsl text eol=crlf

# Binary files should not be modified
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.epf binary
*.erf binary
