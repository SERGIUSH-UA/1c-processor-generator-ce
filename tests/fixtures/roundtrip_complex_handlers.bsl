&НаКлиенте
Функция ПроверитьПараметры()
	Если Количество <= 0 Тогда
		Сообщить("Количество должно быть больше 0");
		Возврат Ложь;
	КонецЕсли;

	Если Сумма < 0 Тогда
		Сообщить("Сумма не может быть отрицательной");
		Возврат Ложь;
	КонецЕсли;

	Если Коэффициент <= 0 Тогда
		Сообщить("Коэффициент должен быть больше 0");
		Возврат Ложь;
	КонецЕсли;

	Возврат Истина;
КонецФункции

&НаКлиенте
Процедура ДобавитьВЛог(Текст)
	ВремяСтамп = Формат(ТекущаяДата(), "ДФ='dd.MM.yyyy HH:mm:ss'");
	СтрокаЛога = "[" + ВремяСтамп + "] " + Текст;

	Если ЗначениеЗаполнено(ЛогОпераций) Тогда
		ЛогОпераций = ЛогОпераций + Символы.ПС + СтрокаЛога;
	Иначе
		ЛогОпераций = СтрокаЛога;
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ДобавитьВИсторию(НазваниеОперации, Сумма)
	НоваяСтрока = ИсторияОпераций.Добавить();
	НоваяСтрока.Дата = ТекущаяДата();
	НоваяСтрока.Операция = НазваниеОперации;
	НоваяСтрока.Сумма = Сумма;
	НоваяСтрока.Пользователь = ИмяПользователя();

	Счетчик = ИсторияОпераций.Количество();
КонецПроцедуры

