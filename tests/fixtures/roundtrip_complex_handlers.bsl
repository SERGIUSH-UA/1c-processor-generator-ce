	КонецЕсли;

	ЭкспортДанныхНаСервере();

	Сообщить(СтрШаблон("Экспортировано записей: %1", РезультатыОбработки.Количество()));
	ДобавитьВЛог(СтрШаблон("Данные экспортированы: %1 записей", РезультатыОбработки.Количество()));
КонецПроцедуры

&НаСервере
Процедура ЭкспортДанныхНаСервере()
	// Формування даних для експорту
	МассивДанных = Новый Массив;

	Для Каждого Строка Из РезультатыОбработки Цикл
		Элемент = Новый Структура;
		Элемент.Вставить("Название", Строка.Название);
		Элемент.Вставить("Значение", Строка.Значение);
		Элемент.Вставить("Статус", Строка.Статус);
		Элемент.Вставить("Дата", Строка.Дата);

		МассивДанных.Добавить(Элемент);
	КонецЦикла;

	// Тут має бути запис у файл або відправка
КонецПроцедуры

