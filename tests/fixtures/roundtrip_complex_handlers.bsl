КонецПроцедуры

&НаСервере
Процедура ЗагрузитьНастройкиНаСервере()
	Настройки.Очистить();

	// Завантаження стандартних налаштувань
	МассивНастроек = Новый Массив;
	МассивНастроек.Добавить(Новый Структура("Параметр, Значение, Описание",
		"Таймаут", "30", "Таймаут подключения в секундах"));
	МассивНастроек.Добавить(Новый Структура("Параметр, Значение, Описание",
		"МаксРетраев", "3", "Максимальное количество повторов"));
	МассивНастроек.Добавить(Новый Структура("Параметр, Значение, Описание",
		"ЛогУровень", "INFO", "Уровень логирования (DEBUG, INFO, WARN, ERROR)"));
	МассивНастроек.Добавить(Новый Структура("Параметр, Значение, Описание",
		"КэшВремя", "3600", "Время кеширования в секундах"));

	Для Каждого Элемент Из МассивНастроек Цикл
		НоваяСтрока = Настройки.Добавить();
		НоваяСтрока.Параметр = Элемент.Параметр;
		НоваяСтрока.Значение = Элемент.Значение;
		НоваяСтрока.Описание = Элемент.Описание;
	КонецЦикла;
КонецПроцедуры

