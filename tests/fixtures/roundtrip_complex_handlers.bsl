// СОБЫТИЯ ФОРМЫ

Процедура ПриОткрытии(Отказ)
	// Ініціалізація значень за замовчуванням
	Если НЕ ЗначениеЗаполнено(ДатаНачала) Тогда
		ДатаНачала = НачалоДня(ТекущаяДата());
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(ДатаОкончания) Тогда
		ДатаОкончания = КонецДня(ТекущаяДата());
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(Активен) Тогда
		Активен = Истина;
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(Количество) Тогда
		Количество = 10;
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(Коэффициент) Тогда
		Коэффициент = 1.0000;
	КонецЕсли;

	ДобавитьВЛог("Форма открыта: " + ТекущаяДата());

	// Виклик серверної частини
	ПриОткрытииНаСервере();
КонецПроцедуры

&НаСервере
Процедура ПриОткрытииНаСервере()
	// Завантаження збережених налаштувань
	ЗагрузитьНастройкиИзХранилища();

	// Завантаження історії операцій
	ЗагрузитьИсториюОпераций();

	// Оновлення статистики
	ОбновитьСтатистикуНаСервере();

	ПоследнееОбновление = ТекущаяДата();
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	// Ініціалізація значень за замовчуванням на сервері
	Если НЕ ЗначениеЗаполнено(АдресСервера) Тогда
		АдресСервера = "https://api.example.com";
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(Email) Тогда
		Email = "test@example.com";
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(Процент) Тогда
		Процент = 10.00;
	КонецЕсли;
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// КОМАНДЫ - ОСНОВНІ ОПЕРАЦІЇ

&НаКлиенте
Процедура ВыполнитьОбработку(Команда)
	Если НЕ Активен Тогда
		Сообщить("Обработка неактивна. Включите флаг 'Активен'");
		Возврат;
	КонецЕсли;

	Если НЕ ПроверитьПараметры() Тогда
		Возврат;
	КонецЕсли;

	ОчиститьРезультатыНаКлиенте();

	ДобавитьВЛог("--- Начало выполнения обработки ---");
	ДобавитьВЛог(СтрШаблон("Параметры: Количество=%1, Сумма=%2, Коэффициент=%3",
		Количество, Сумма, Коэффициент));

	ВыполнитьНаСервере();

	Сообщить("Обработка выполнена успешно");
	ДобавитьВЛог("--- Обработка завершена ---");
КонецПроцедуры

&НаСервере
Процедура ВыполнитьНаСервере()
	НачалоВыполнения = ТекущаяДата();

	Попытка
		Для Сч = 1 По Количество Цикл
			НоваяСтрока = РезультатыОбработки.Добавить();
			НоваяСтрока.Название = "Операция " + Формат(Сч, "ЧЦ=3; ЧВН=");

			РасчетнаяСумма = Сумма * Коэффициент * (1 + Процент / 100);
			НоваяСтрока.Значение = Формат(РасчетнаяСумма, "ЧЦ=15; ЧДЦ=2; ЧРД=.; ЧГ=3,0");
			НоваяСтрока.Статус = "Выполнено";
			НоваяСтрока.Дата = ТекущаяДата();

			// Додавання в історію
			ДобавитьВИсторию("Операция " + Сч, РасчетнаяСумма);
		КонецЦикла;

		КонецВыполнения = ТекущаяДата();
		Длительность = КонецВыполнения - НачалоВыполнения;

		ДобавитьВЛог(СтрШаблон("Обработано записей: %1, Длительность: %2 сек",
			Количество, Длительность));

		// Оновлення статистики
		ОбновитьСтатистикуНаСервере();

	Исключение
		ТекстОшибки = ОписаниеОшибки();
		ДобавитьВЛог("ОШИБКА: " + ТекстОшибки);
		ВызватьИсключение ТекстОшибки;
	КонецПопытки;
КонецПроцедуры

&НаКлиенте
Процедура ОчиститьРезультаты(Команда)
	ОчиститьРезультатыНаКлиенте();
	Сообщить("Результаты очищены");
	ДобавитьВЛог("Результаты очищены");
КонецПроцедуры

&НаКлиенте
Процедура ОчиститьРезультатыНаКлиенте()
	РезультатыОбработки.Очистить();
КонецПроцедуры

