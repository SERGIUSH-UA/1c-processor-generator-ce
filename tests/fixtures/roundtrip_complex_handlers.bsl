&НаКлиенте
Процедура ОбновитьСтатистику(Команда)
	ДобавитьВЛог("Обновление статистики...");
	ОбновитьСтатистикуНаСервере();
	ПоследнееОбновление = ТекущаяДата();
	Сообщить("Статистика обновлена");
	ДобавитьВЛог("Статистика обновлена");
КонецПроцедуры

&НаСервере
Процедура ОбновитьСтатистикуНаСервере()
	СтатистикаДанные.Очистить();

	// Кількість результатів
	НоваяСтрока = СтатистикаДанные.Добавить();
	НоваяСтрока.Показатель = "Всего результатов";
	НоваяСтрока.Значение = РезультатыОбработки.Количество();
	НоваяСтрока.Единица = "шт";

	// Кількість операцій в історії
	НоваяСтрока = СтатистикаДанные.Добавить();
	НоваяСтрока.Показатель = "Операций в истории";
	НоваяСтрока.Значение = ИсторияОпераций.Количество();
	НоваяСтрока.Единица = "шт";

	// Загальна сума
	ОбщаяСумма = 0;
	Для Каждого Строка Из ИсторияОпераций Цикл
		ОбщаяСумма = ОбщаяСумма + Строка.Сумма;
	КонецЦикла;

	НоваяСтрока = СтатистикаДанные.Добавить();
	НоваяСтрока.Показатель = "Общая сумма операций";
	НоваяСтрока.Значение = ОбщаяСумма;
	НоваяСтрока.Единица = "руб";

	// Середня сума
	Если ИсторияОпераций.Количество() > 0 Тогда
		СредняяСумма = ОбщаяСумма / ИсторияОпераций.Количество();
	Иначе
		СредняяСумма = 0;
	КонецЕсли;

	НоваяСтрока = СтатистикаДанные.Добавить();
	НоваяСтрока.Показатель = "Средняя сумма";
	НоваяСтрока.Значение = СредняяСумма;
	НоваяСтрока.Единица = "руб";

	// Налаштування
	НоваяСтрока = СтатистикаДанные.Добавить();
	НоваяСтрока.Показатель = "Параметров настройки";
	НоваяСтрока.Значение = Настройки.Количество();
	НоваяСтрока.Единица = "шт";
КонецПроцедуры

