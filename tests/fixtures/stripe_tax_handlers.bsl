&НаКлиенте
Процедура ТестTexasSaaS(Команда)

	НачатьТест("Texas SaaS (80% taxable)");

	// Заполняем данные для Texas SaaS
	Объект.АдресСтрока1 = "789 Tech Park";
	Объект.Город = "Austin";
	Объект.Штат = "TX";
	Объект.ПочтовыйИндекс = "78701";
	Объект.TaxID = "";
	Объект.ТипКлиента = "B2C";

	Объект.Сумма = 100.00;
	Объект.Количество = 1;
	Объект.TaxCode = "txcd_10103000"; // SaaS

	// Выполняем тест
	РезультатТеста = ВыполнитьТестРасчетаНаСервере();

	ЗавершитьТест("Texas SaaS (80% taxable)", РезультатТеста);

	Если РезультатТеста.Успешно Тогда
		ПроцентОподаткування = 0;
		Если РезультатТеста.Свойство("НалоговаяБаза") И РезультатТеста.НалоговаяБаза > 0 Тогда
			ПроцентОподаткування = Окр((РезультатТеста.НалоговаяБаза / Объект.Сумма) * 100, 0);
		КонецЕсли;

		ПоказатьПредупреждение(, СтрШаблон("Тест Texas SaaS выполнен успешно!%1Налоговая база: %2 USD (%3%% от суммы)%4Ожидалось: 80%%",
			Символы.ПС, РезультатТеста.НалоговаяБаза, ПроцентОподаткування, Символы.ПС));
	Иначе
		ПоказатьПредупреждение(, "Ошибка теста: " + РезультатТеста.ТекстОшибки);
	КонецЕсли;

КонецПроцедуры

// ========================================
// Подключение
// ========================================

&НаКлиенте
Процедура ПроверитьПодключение(Команда)

	ПроверитьПодключениеНаСервере();

КонецПроцедуры

&НаСервере
Процедура ПроверитьПодключениеНаСервере()

	Попытка

		// Проверяем наличие ключа API
		Если НЕ ЗначениеЗаполнено(Объект.КлючAPI) Тогда
			Объект.СтатусПодключения = "❌ Не настроен ключ API";
			ДобавитьВЛог("ОШИБКА: Ключ API не настроен");
			Возврат;
		КонецЕсли;

		// Пытаемся выполнить тестовый запрос к API
		РезультатHTTP = МенеджерИнтеграцииStripeTax.ВыполнитьHTTPЗапросStripeTax(
			"GET",
			"/v1/products?limit=1",
			"",
			Объект.Организация
		);

		Если РезультатHTTP.Успех Тогда
			Объект.СтатусПодключения = "✅ Подключение успешно (HTTP 200)";
			ДобавитьВЛог("Подключение к Stripe Tax API успешно установлено");
		Иначе
			Объект.СтатусПодключения = СтрШаблон("❌ Ошибка подключения: HTTP %1", РезультатHTTP.КодСостояния);
			ДобавитьВЛог(СтрШаблон("ОШИБКА подключения: %1", РезультатHTTP.ТекстОшибки));
		КонецЕсли;

	Исключение

		Объект.СтатусПодключения = "❌ Ошибка: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		ДобавитьВЛог("ОШИБКА: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));

	КонецПопытки;

КонецПроцедуры

