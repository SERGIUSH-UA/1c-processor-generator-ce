&НаСервере
Процедура ОбновитьКэшНаСервере()

	Попытка

		КэшЗаписи.Очистить();

		Запрос = Новый Запрос;
		Запрос.Текст = "
		|ВЫБРАТЬ
		|	Кэш.Контрагент КАК Контрагент,
		|	Кэш.Номенклатура КАК Номенклатура,
		|	Кэш.Сумма КАК Сумма,
		|	Кэш.СтавкаНалога КАК СтавкаНалога,
		|	Кэш.ЭффективнаяСтавка КАК ЭффективнаяСтавка,
		|	Кэш.ДатаРасчета КАК ДатаРасчета,
		|	Кэш.СрокДействия КАК СрокДействия
