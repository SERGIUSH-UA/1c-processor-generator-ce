&НаКлиенте
Процедура ЗавершитьТест(НазваниеТеста, РезультатТеста)

	Если РезультатТеста.Успешно Тогда
		Объект.ПоследнийТестРезультат = "✅ Успешно";
	Иначе
		Объект.ПоследнийТестРезультат = "❌ Ошибка";
	КонецЕсли;

	// Добавляем в историю
	НоваяСтрока = ИсторияТестов.Добавить();
	НоваяСтрока.ДатаВремя = ТекущаяДата();
	НоваяСтрока.НазваниеТеста = НазваниеТеста;
	НоваяСтрока.Результат = Объект.ПоследнийТестРезультат;

	Если РезультатТеста.Свойство("ВремяВыполнения") Тогда
		НоваяСтрока.ВремяВыполнения = РезультатТеста.ВремяВыполнения;
	КонецЕсли;

	Если РезультатТеста.Успешно Тогда
		НоваяСтрока.Детали = СтрШаблон("Сумма: %1 USD, Ставка: %2%",
			РезультатТеста.СуммаНалога, РезультатТеста.ЭффективнаяСтавка);
	Иначе
		НоваяСтрока.Детали = РезультатТеста.ТекстОшибки;
	КонецЕсли;

	ДобавитьВЛог(СтрШаблон("=== ЗАВЕРШЕНИЕ ТЕСТА: %1 (%2) ===", НазваниеТеста, Объект.ПоследнийТестРезультат));

КонецПроцедуры

&НаСервере
Функция СоздатьТестовогоКонтрагента()

	// Создаем временный объект контрагента для тестирования
	// НЕ записываем в базу!

	ТестовыйКонтрагент = Справочники.Контрагенты.СоздатьЭлемент();

	// Заполняем из полей обработки
	ТестовыйКонтрагент.Наименование = "Тестовый контрагент";

	// Адрес будет взят из полей Страна, РегионСтраны и через КонтактнаяИнформация
	// если модуль МенеджерИнтеграцииStripeTax требует

	// Страна
	СтранаСША = Справочники.СтраныМира.НайтиПоКоду("US");
	Если ЗначениеЗаполнено(СтранаСША) Тогда
		ТестовыйКонтрагент.Страна = СтранаСША;
	КонецЕсли;

	// Штат
	Если ЗначениеЗаполнено(Объект.Штат) Тогда
		Запрос = Новый Запрос;
		Запрос.Текст = "
		|ВЫБРАТЬ ПЕРВЫЕ 1
		|	РегионыСтраны.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.РегионыСтраны КАК РегионыСтраны
		|ГДЕ
		|	РегионыСтраны.Код = &Код";
		Запрос.УстановитьПараметр("Код", Объект.Штат);
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			ТестовыйКонтрагент.РегионСтраны = Выборка.Ссылка;
		КонецЕсли;
	КонецЕсли;

	// ИНН (для B2B)
	Если ЗначениеЗаполнено(Объект.TaxID) Тогда
		ТестовыйКонтрагент.ИНН = Объект.TaxID;
		ТестовыйКонтрагент.ЮридическоеФизическоеЛицо = Перечисления.ЮридическоеФизическоеЛицо.ЮридическоеЛицо;
	Иначе
		ТестовыйКонтрагент.ЮридическоеФизическоеЛицо = Перечисления.ЮридическоеФизическоеЛицо.ФизическоеЛицо;
	КонецЕсли;

	Возврат ТестовыйКонтрагент;

КонецФункции

&НаСервере
Функция СоздатьТестовыйДокумент()

	// Создаем временный документ для тестирования
	// НЕ записываем в базу!

	ТестовыйДокумент = Документы.СчетНаОплатуПокупателю.СоздатьДокумент();

	ТестовыйДокумент.Дата = ТекущаяДата();
	ТестовыйДокумент.Организация = Объект.Организация;
	ТестовыйДокумент.Контрагент = СоздатьТестовогоКонтрагента();

	// Добавляем строку номенклатуры
	НоваяСтрока = ТестовыйДокумент.Номенклатура.Добавить();

	Если ЗначениеЗаполнено(Объект.ТестоваяНоменклатура) Тогда
		НоваяСтрока.Номенклатура = Объект.ТестоваяНоменклатура;
	Иначе
		// Создаем временную номенклатуру
		НоваяСтрока.Номенклатура = СоздатьТестовуюНоменклатуру();
	КонецЕсли;

	НоваяСтрока.Количество = Объект.Количество;
	НоваяСтрока.Сумма = Объект.Сумма;

	Возврат ТестовыйДокумент;

КонецФункции

