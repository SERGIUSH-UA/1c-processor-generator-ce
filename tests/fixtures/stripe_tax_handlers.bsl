// ========================================

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	// Инициализация при открытии формы
	Если НЕ ЗначениеЗаполнено(Объект.Организация) Тогда
		Объект.Организация = ПолучитьОрганизациюПоУмолчанию();
	КонецЕсли;

	// Загружаем настройки
	ЗагрузитьНастройкиНаСервере();

	// Проверяем подключение автоматически
	ПроверитьПодключениеНаСервере();

	// Загружаем историю тестов
	ЗагрузитьИсториюТестов();

	ДобавитьВЛог("Обработка открыта. Готова к тестированию.");

КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	// Инициализация значений по умолчанию
	Если НЕ ЗначениеЗаполнено(Объект.АдресСервера) Тогда
		Объект.АдресСервера = "api.stripe.com";
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(Объект.ВерсияAPI) Тогда
		Объект.ВерсияAPI = "2023-10-16";
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(Объект.Количество) Тогда
		Объект.Количество = 1;
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(Объект.Сумма) Тогда
		Объект.Сумма = 100.00;
	КонецЕсли;

КонецПроцедуры

