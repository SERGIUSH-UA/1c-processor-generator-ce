&НаКлиенте
Процедура ТестMarylandB2B(Команда)

	НачатьТест("Maryland B2B (3%)");

	// Заполняем данные для Maryland B2B
	Объект.АдресСтрока1 = "123 Business Blvd";
	Объект.Город = "Baltimore";
	Объект.Штат = "MD";
	Объект.ПочтовыйИндекс = "21201";
	Объект.TaxID = "12-3456789";
	Объект.ТипКлиента = "B2B";

	Объект.Сумма = 100.00;
	Объект.Количество = 1;
	Объект.TaxCode = "txcd_10502000"; // Professional Services

	// Выполняем тест
	РезультатТеста = ВыполнитьТестРасчетаНаСервере();

	ЗавершитьТест("Maryland B2B (3%)", РезультатТеста);

	Если РезультатТеста.Успешно Тогда
		ПоказатьПредупреждение(, СтрШаблон("Тест Maryland B2B выполнен успешно!%1Эффективная ставка: %2%%3Ожидалось: 3%",
			Символы.ПС, РезультатТеста.ЭффективнаяСтавка, Символы.ПС));
	Иначе
		ПоказатьПредупреждение(, "Ошибка теста: " + РезультатТеста.ТекстОшибки);
	КонецЕсли;

КонецПроцедуры

