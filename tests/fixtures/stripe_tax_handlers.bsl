			МенеджерЗаписи.ДатаРасчета = Выборка.ДатаРасчета;
			МенеджерЗаписи.Удалить();
			КоличествоУдалено = КоличествоУдалено + 1;
		КонецЦикла;

		ДобавитьВЛог(СтрШаблон("Очищено %1 устаревших записей кэша", КоличествоУдалено));

	Исключение

		ДобавитьВЛог("ОШИБКА очистки устаревшего кэша: " + ОписаниеОшибки());

	КонецПопытки;

