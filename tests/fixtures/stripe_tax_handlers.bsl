// ========================================
// Тест расчета
// ========================================

&НаКлиенте
Процедура ВыполнитьПолныйТест(Команда)

	НачатьТест("Полный тест расчета");

	РезультатТеста = ВыполнитьТестРасчетаНаСервере();

	ЗавершитьТест("Полный тест расчета", РезультатТеста);

	Если РезультатТеста.Успешно Тогда
		ПоказатьПредупреждение(, СтрШаблон("Тест выполнен успешно!%1Сумма налога: %2 USD%3Эффективная ставка: %4%",
			Символы.ПС, РезультатТеста.СуммаНалога, Символы.ПС, РезультатТеста.ЭффективнаяСтавка));
	Иначе
		ПоказатьПредупреждение(, "Ошибка теста: " + РезультатТеста.ТекстОшибки);
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция ВыполнитьТестРасчетаНаСервере()

	Результат = Новый Структура;
	Результат.Вставить("Успешно", Ложь);
	Результат.Вставить("СуммаНалога", 0);
	Результат.Вставить("ЭффективнаяСтавка", 0);
	Результат.Вставить("НалоговаяБаза", 0);
	Результат.Вставить("ТекстОшибки", "");

	Попытка

		// Создаем временный документ для тестирования
		ТестовыйДокумент = СоздатьТестовыйДокумент();

		// Вызываем основную функцию расчета налогов
		ВремяНачала = ТекущаяУниверсальнаяДатаВМиллисекундах();
		РезультатРасчета = МенеджерИнтеграцииStripeTax.РассчитатьНалоги(ТестовыйДокумент);
		ВремяВыполнения = (ТекущаяУниверсальнаяДатаВМиллисекундах() - ВремяНачала) / 1000;

		Если РезультатРасчета.Успешно Тогда

			Результат.Успешно = Истина;
			Результат.СуммаНалога = РезультатРасчета.СуммаНалога;

			// Обрабатываем детали первой строки
			Если РезультатРасчета.ДанныеНалогов.Количество() > 0 Тогда
				ДанныеНалога = РезультатРасчета.ДанныеНалогов[0];
				Результат.ЭффективнаяСтавка = ДанныеНалога.ЭффективнаяСтавка;
				Результат.НалоговаяБаза = ДанныеНалога.НалоговаяБаза;
			КонецЕсли;

			// Отображаем детальные результаты
			ОтобразитьРезультатыРасчета(РезультатРасчета);

			ДобавитьВЛог(СтрШаблон("Расчет выполнен успешно за %1 сек. Сумма налога: %2 USD",
				ВремяВыполнения, РезультатРасчета.СуммаНалога));

		Иначе

			Результат.ТекстОшибки = РезультатРасчета.ТекстОшибки;
			ДобавитьВЛог("ОШИБКА расчета: " + Результат.ТекстОшибки);

		КонецЕсли;

	Исключение

		Результат.ТекстОшибки = ОписаниеОшибки();
		ДобавитьВЛог("ОШИБКА выполнения теста: " + Результат.ТекстОшибки);

	КонецПопытки;

	Возврат Результат;

КонецФункции

