Процедура ЗагрузитьНастройки(Команда)

	ЗагрузитьНастройкиНаСервере();

	ПоказатьПредупреждение(, "Настройки загружены из базы данных");

КонецПроцедуры

&НаСервере
Процедура ЗагрузитьНастройкиНаСервере()

	Попытка

		// Загружаем ключ API
		КлючAPI = МенеджерИнтеграцииStripeTax.ПолучитьКлючStripeTax(Объект.Организация);
		Если ЗначениеЗаполнено(КлючAPI) Тогда
			Объект.КлючAPI = КлючAPI;
		КонецЕсли;

		// Загружаем версию API
		ВерсияAPI = МенеджерИнтеграцииStripeTax.ПолучитьНастройкуStripeTax("ВерсияAPIStripeTax");
		Если ЗначениеЗаполнено(ВерсияAPI) Тогда
			Объект.ВерсияAPI = ВерсияAPI;
		КонецЕсли;

		ДобавитьВЛог("Настройки загружены из базы данных");

	Исключение

		ДобавитьВЛог("ОШИБКА загрузки настроек: " + ОписаниеОшибки());

	КонецПопытки;

КонецПроцедуры

// ========================================
// Тест клиента
// ========================================

&НаКлиенте
Процедура ПодготовитьДанныеКлиента(Команда)

	РезультатПодготовки = ПодготовитьДанныеКлиентаНаСервере();

	Если РезультатПодготовки.Успешно Тогда

		// Отображаем результат в таблице
		РезультатыРасчета.Очистить();

		Для Каждого КлючЗначение Из РезультатПодготовки.ДанныеКлиента Цикл
			НоваяСтрока = РезультатыРасчета.Добавить();
			НоваяСтрока.НазваниеПоля = КлючЗначение.Ключ;
			НоваяСтрока.Значение = Строка(КлючЗначение.Значение);
			НоваяСтрока.Описание = ОписаниеПоляКлиента(КлючЗначение.Ключ);
		КонецЦикла;

		Объект.ТипКлиента = РезультатПодготовки.ТипКлиента;

		ПоказатьПредупреждение(, СтрШаблон("Данные клиента подготовлены успешно!%1Тип клиента: %2",
			Символы.ПС, РезультатПодготовки.ТипКлиента));

	Иначе

		ПоказатьПредупреждение(, "Ошибка подготовки данных: " + РезультатПодготовки.ТекстОшибки);

	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция ПодготовитьДанныеКлиентаНаСервере()

	Результат = Новый Структура;
	Результат.Вставить("Успешно", Ложь);
	Результат.Вставить("ДанныеКлиента", Неопределено);
	Результат.Вставить("ТипКлиента", "");
	Результат.Вставить("ТекстОшибки", "");

	Попытка

		// Создаем временный контрагент для тестирования
		ТестовыйКонтрагент = СоздатьТестовогоКонтрагента();

		// Подготавливаем данные через модуль
		ДанныеКлиента = МенеджерИнтеграцииStripeTax.ПодготовитьДанныеКлиента(ТестовыйКонтрагент);

		Если ДанныеКлиента <> Неопределено Тогда
			Результат.Успешно = Истина;
			Результат.ДанныеКлиента = ДанныеКлиента;

			// Определяем тип клиента
			ТипКлиента = "B2C";
			Если ДанныеКлиента.Свойство("tax_ids") Тогда
				ТипКлиента = "B2B";
			КонецЕсли;
			Результат.ТипКлиента = ТипКлиента;

			ДобавитьВЛог(СтрШаблон("Данные клиента подготовлены: %1", ТипКлиента));
		Иначе
			Результат.ТекстОшибки = "Модуль вернул Неопределено";
		КонецЕсли;

	Исключение

		Результат.ТекстОшибки = ОписаниеОшибки();
		ДобавитьВЛог("ОШИБКА подготовки данных клиента: " + Результат.ТекстОшибки);

	КонецПопытки;

	Возврат Результат;

КонецФункции

