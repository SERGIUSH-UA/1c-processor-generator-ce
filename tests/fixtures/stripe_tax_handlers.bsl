&НаСервере
Процедура ОчиститьУстаревшийКэшНаСервере()

	Попытка

		МаксимальныйРазмер = МенеджерИнтеграцииStripeTax.ПолучитьНастройкуStripeTax("МаксимальныйРазмерКэшаStripeTax");

		// Вызываем процедуру очистки из модуля
		// (НЕ можем вызвать напрямую, так как она не экспортная, поэтому делаем вручную)

		ТекущаяДата_НачалоДня = НачалоДня(ТекущаяДата());

		Запрос = Новый Запрос;
		Запрос.Текст = "
		|ВЫБРАТЬ
		|	Кэш.Контрагент КАК Контрагент,
		|	Кэш.Номенклатура КАК Номенклатура,
		|	Кэш.Сумма КАК Сумма,
		|	Кэш.ДатаРасчета КАК ДатаРасчета
		|ИЗ
		|	РегистрСведений.КэшНалоговыхРасчетовStripeTax КАК Кэш
		|ГДЕ
		|	Кэш.СрокДействия < &ТекущаяДата";

		Запрос.УстановитьПараметр("ТекущаяДата", ТекущаяДата_НачалоДня);

		Выборка = Запрос.Выполнить().Выбрать();

		КоличествоУдалено = 0;
		Пока Выборка.Следующий() Цикл
			МенеджерЗаписи = РегистрыСведений.КэшНалоговыхРасчетовStripeTax.СоздатьМенеджерЗаписи();
