&НаСервере
Процедура ОтобразитьРезультатыРасчета(РезультатРасчета)

	РезультатыРасчета.Очистить();

	// Общая информация
	ДобавитьРезультат("Успешно", РезультатРасчета.Успешно, "Признак успешного расчета");
	ДобавитьРезультат("Сумма налога", РезультатРасчета.СуммаНалога, "Общая сумма налогов (USD)");

	Если РезультатРасчета.Свойство("ИзКэша") Тогда
		ДобавитьРезультат("Из кэша", РезультатРасчета.ИзКэша, "Данные получены из кэша");
	КонецЕсли;

	// Детали по строкам
	Если РезультатРасчета.ДанныеНалогов.Количество() > 0 Тогда

		Индекс = 1;
		Для Каждого ДанныеНалога Из РезультатРасчета.ДанныеНалогов Цикл

			Префикс = СтрШаблон("Строка %1: ", Индекс);

			ДобавитьРезультат(Префикс + "Сумма налога", ДанныеНалога.СуммаНалога, "Сумма налога для строки");
			ДобавитьРезультат(Префикс + "Налоговая база", ДанныеНалога.НалоговаяБаза, "Сумма, с которой рассчитан налог");
			ДобавитьРезультат(Префикс + "Ставка налога", ДанныеНалога.СтавкаНалога, "Базовая ставка налога (%)");
			ДобавитьРезультат(Префикс + "Эффективная ставка", ДанныеНалога.ЭффективнаяСтавка, "Фактическая ставка с учетом льгот (%)");
			ДобавитьРезультат(Префикс + "Тип ставки", ДанныеНалога.ТипСтавки, "Тип налогообложения");

			Если ДанныеНалога.ЕстьЛьгота Тогда
				ДобавитьРезультат(Префикс + "Льготная сумма", ДанныеНалога.ЛьготнаяСумма, "Сумма, освобожденная от налога");
				Если ЗначениеЗаполнено(ДанныеНалога.ПричинаЛьготы) Тогда
					ДобавитьРезультат(Префикс + "Причина льготы", ДанныеНалога.ПричинаЛьготы, "Код причины льготы от Stripe");
				КонецЕсли;
			КонецЕсли;

			Если ДанныеНалога.Свойство("ШтатНалога") И ЗначениеЗаполнено(ДанныеНалога.ШтатНалога) Тогда
				ДобавитьРезультат(Префикс + "Штат", ДанныеНалога.ШтатНалога, "Штат налогообложения");
			КонецЕсли;

			Индекс = Индекс + 1;

		КонецЦикла;

	КонецЕсли;

КонецПроцедуры

&НаСервере
