		|	Кэш.ДатаРасчета УБЫВ";

		Выборка = Запрос.Выполнить().Выбрать();

		Пока Выборка.Следующий() Цикл
			НоваяСтрока = КэшЗаписи.Добавить();
			НоваяСтрока.Контрагент = Строка(Выборка.Контрагент);
