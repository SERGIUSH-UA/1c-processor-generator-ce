		КонецЦикла;

		ДобавитьВЛог(СтрШаблон("Загружено %1 записей кэша", КэшЗаписи.Количество()));

	Исключение

		ДобавитьВЛог("ОШИБКА обновления кэша: " + ОписаниеОшибки());

