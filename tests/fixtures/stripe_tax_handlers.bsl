// ========================================
// Результаты
// ========================================

&НаКлиенте
Процедура ЭкспортРезультатов(Команда)

	ЭкспортироватьРезультатыВJSON();

КонецПроцедуры

&НаСервере
Процедура ЭкспортироватьРезультатыВJSON()

	Попытка

		// Формируем структуру для экспорта
		ДанныеЭкспорта = Новый Структура;
		ДанныеЭкспорта.Вставить("ДатаВремя", ТекущаяДата());
		ДанныеЭкспорта.Вставить("Организация", Строка(Объект.Организация));

		// Результаты
		МассивРезультатов = Новый Массив;
		Для Каждого Строка Из РезультатыРасчета Цикл
			Элемент = Новый Структура;
			Элемент.Вставить("Поле", Строка.НазваниеПоля);
			Элемент.Вставить("Значение", Строка.Значение);
			Элемент.Вставить("Описание", Строка.Описание);
			МассивРезультатов.Добавить(Элемент);
		КонецЦикла;
		ДанныеЭкспорта.Вставить("Результаты", МассивРезультатов);

		// Сериализация в JSON
		ЗаписьJSON = Новый ЗаписьJSON;
		ЗаписьJSON.УстановитьСтроку();
		ЗаписатьJSON(ЗаписьJSON, ДанныеЭкспорта);
		ТекстJSON = ЗаписьJSON.Закрыть();

		// Сохраняем в файл
		ПутьКФайлу = ПолучитьИмяВременногоФайла("json");
		Текст = Новый ТекстовыйДокумент;
		Текст.УстановитьТекст(ТекстJSON);
		Текст.Записать(ПутьКФайлу, КодировкаТекста.UTF8);

		ДобавитьВЛог("Результаты экспортированы в: " + ПутьКФайлу);

		Сообщить("Результаты экспортированы в файл: " + ПутьКФайлу);

	Исключение

		ДобавитьВЛог("ОШИБКА экспорта: " + ОписаниеОшибки());

	КонецПопытки;

КонецПроцедуры

