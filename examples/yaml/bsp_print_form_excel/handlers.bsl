// BSP Print Form Handler - Product Card
//
// Print form code lives in the ObjectModule, so it MUST be placed inside the
// #Область МодульОбъекта region - that is the only channel from handlers.bsl
// into ObjectModule.bsl. Code outside this region is loaded but never applied:
// the generator emits a TODO stub instead and the report prints an empty page.
//
// Compilation directives (&НаСервере, &НаКлиенте) are NOT used here - they are
// a form module concept and would make ObjectModule code invalid.
//
// Function name: Печать{command.id}, or the custom name from `handler:` in YAML.
// Signature is fixed: (МассивОбъектов, ОбъектыПечати) -> ТабличныйДокумент

#Область МодульОбъекта

Функция ПечатьКарточкаНоменклатуры(МассивОбъектов, ОбъектыПечати)

	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.КлючПараметровПечати = "ПАРАМЕТРЫ_ПЕЧАТИ_КарточкаНоменклатуры";

	Макет = ПолучитьМакет("ПФ_MXL_КарточкаНоменклатуры");
	ОбластьЗаголовок = Макет.ПолучитьОбласть("Заголовок");
	ОбластьДанные = Макет.ПолучитьОбласть("Данные");

	Для Каждого Ссылка Из МассивОбъектов Цикл

		НачалоОбласти = ТабличныйДокумент.ВысотаТаблицы + 1;

		// Page break for multiple items
		Если ТабличныйДокумент.ВысотаТаблицы > 0 Тогда
			ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;

		// Header area
		ОбластьЗаголовок.Параметры.Наименование = Ссылка.Наименование;
		ТабличныйДокумент.Вывести(ОбластьЗаголовок);

		// Data area - fill all fields
		ОбластьДанные.Параметры.Код = Ссылка.Код;
		ОбластьДанные.Параметры.Артикул = Ссылка.Артикул;
		ОбластьДанные.Параметры.НаименованиеПолное = Ссылка.НаименованиеПолное;
		ОбластьДанные.Параметры.ВидНоменклатуры = Строка(Ссылка.ВидНоменклатуры);
		ОбластьДанные.Параметры.ЕдиницаИзмерения = Строка(Ссылка.ЕдиницаИзмерения);
		ОбластьДанные.Параметры.СтавкаНДС = Строка(Ссылка.СтавкаНДС);
		ТабличныйДокумент.Вывести(ОбластьДанные);

		// Bind the printed area to the source object (required by БСП)
		УправлениеПечатью.ЗадатьОбластьПечатиДокумента(ТабличныйДокумент, НачалоОбласти, ОбъектыПечати, Ссылка);

	КонецЦикла;

	ТабличныйДокумент.АвтоМасштаб = Истина;
	ТабличныйДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Портрет;

	Возврат ТабличныйДокумент;

КонецФункции

#КонецОбласти
